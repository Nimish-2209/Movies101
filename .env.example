# Generate a value with: openssl rand -hex 64
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=2h

# Combined login/signup attempts allowed per client IP and window
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Allow active HTTP requests to finish before a forced shutdown
SHUTDOWN_TIMEOUT_MS=10000

# TMDB API Read Access Token (server only)
TMDB_READ_ACCESS_TOKEN=

# Reel Talk: local Ollama defaults
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=granite4.1:3b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_MS=60000
AI_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_MS=60000
